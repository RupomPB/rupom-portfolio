# ============================================================
# OBSCURA PORTFOLIO — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to source control.

# ----- Resend Email Integration -----
# Get your free API key at https://resend.com
RESEND_API_KEY=re_your_key_here

# The email address where contact form messages are delivered.
CONTACT_EMAIL=rupombadhan111@gmail.com

# The FROM address Resend uses when sending emails.
# This MUST be a domain verified in your Resend account dashboard.
# Example: "Rupom Portfolio <contact@yourdomain.com>"
# Note: You cannot use a Gmail address as the sender without domain verification.
FROM_EMAIL=Portfolio Contact <contact@yourdomain.com>
